    <Property Name="TransactionDate" Type="DateTime" Nullable="false" Precision="3" />
    <Property Name="PaymentMethod" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="TransactionStatus" Type="String" MaxLength="20" FixedLength="false" Unicode="true" Nullable="false" />
