    <Property Name="CategoryID" Type="Int32" />
    <Property Name="JewelName" Type="String" MaxLength="100" FixedLength="false" Unicode="false" />
    <Property Name="JewelPrice" Type="Decimal" />
    <Property Name="JewelReleaseYear" Type="Int32" />
    <NavigationProperty Name="Carts" Relationship="Self.FK_Cart_Jewel" FromRole="MsJewel" ToRole="Cart" />
    <NavigationProperty Name="MsBrand" Relationship="Self.FK_MsJewel_Brand" FromRole="MsJewel" ToRole="MsBrand" />
    <NavigationProperty Name="MsCategory" Relationship="Self.FK_MsJewel_Category" FromRole="MsJewel" ToRole="MsCategory" />
    <NavigationProperty Name="TransactionDetails" Relationship="Self.FK_TransactionDetail_Jewel" FromRole="MsJewel" ToRole="TransactionDetail" />
  </EntityType>
  <EntityType Name="MsUser">
    <Key>
      <PropertyRef Name="UserID" />
    </Key>
    <Property Name="UserID" Type="Int32" Nullable="false" />
    <Property Name="UserName" Type="String" MaxLength="100" FixedLength="false" Unicode="false" />
    <Property Name="UserPassword" Type="String" MaxLength="20" FixedLength="false" Unicode="false" />
    <Property Name="UserEmail" Type="String" MaxLength="100" FixedLength="false" Unicode="false" />
    <Property Name="UserDOB" Type="DateTime" Precision="0" />
    <Property Name="UserGender" Type="String" MaxLength="10" FixedLength="false" Unicode="false" />
    <Property Name="UserRole" Type="String" MaxLength="10" FixedLength="false" Unicode="false" />
    <NavigationProperty Name="Carts" Relationship="Self.FK_Cart_User" FromRole="MsUser" ToRole="Cart" />
    <NavigationProperty Name="TransactionHeaders" Relationship="Self.FK_TransactionHeader_User" FromRole="MsUser" ToRole="TransactionHeader" />
  </EntityType>
  <EntityType Name="TransactionDetail">
    <Key>
      <PropertyRef Name="TransactionID" />
      <PropertyRef Name="JewelID" />
    </Key>
